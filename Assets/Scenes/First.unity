  dialoguePanel: {fileID: 757082645}
  spacebarIcon: {fileID: 1175891044}
  day1Dialogues:
  - "\u201C\uC800 \uD654\uBA74 \uC18D \uCE90\uB9AD\uD130\u2026 \uC65C \uC800\uB807\uAC8C
    \uD750\uB9BF\uD55C\uB370\uB3C4 \uB208\uC774 \uC548 \uB5BC\uC5B4\uC9C0\uC9C0?\u201D "
  - "\u201C\uD574\uC0C1\uB3C4\uB294 \uB0AE\uC740\uB370, \uC774\uC0C1\uD558\uAC8C
    \uC120\uBA85\uD558\uAC8C \uB0A8\uC544.\u201D "
  - "\u201C\uC800\uCABD \uC138\uACC4\uB85C \uAC00\uC57C\uACA0\uC5B4, \uBE44\uB85D
    \uC815\uBCF4\uC758 \uD30C\uB3C4\uB97C \uAC70\uC2AC\uB7EC \uC624\uB974\uB354\uB77C\uB3C4.\""
  day2Dialogues:
  - "\u201C\uC5B4\uC81C \uB9D0\uD558\uB358 \uBC30\uACBD\uC744 \uBCF4\uB2C8\uAE4C\u2026
    \uACF5\uC5F0\uC7A5\uC774\uC5C8\uC5B4.\u201D "
  - "\u201C\uACF5\uC5F0\uC7A5\uC774\uB77C\uBA74, \uC74C\uBC18\uC774\uACA0\uC9C0.\u201D "
  - "\u201C\uC774\uBC88\uC5D4 \uADF8\uAC78 \uB4E4\uACE0 \uB2E4\uC2DC \uAC00\uC57C\uACA0\uB2E4.\u201D "
  day3Dialogues:
  - "\u201C\uC5B4\uC81C\uB294\u2026 \uC9C4\uC9DC \uBD80\uB044\uB7EC\uC6E0\uB2E4.\u201D "
  - "\u201C\uB9D0\uB3C4 \uC548 \uD1B5\uD558\uB294\uB370, \uADF8\uB7F0 \uB9D0\uC744
    \uD558\uB2E4\uB2C8.\u201D "
  - "\u201C\uADF8\uB798\uB3C4\u2026 \uB2E4\uC2DC \uBCF4\uACE0 \uC2F6\uC5B4.\u201D "
  day4Dialogues:
  - "\u201C\uC624\uB298\uB3C4 \uADF8\uB140\uB97C \uB9CC\uB0A0 \uC218 \uC788\uC744\uAC70\uB77C
    \uC0DD\uAC01\uD558\uB2C8...\u201D "
  - "\u201C\uC544\uCE68\uBD80\uD130 \uC2EC\uC7A5\uC774 \uC880 \uBE68\uB9AC \uB6F4\uB2E4.\u201D "
  - "\"\uC624\uB298\uB3C4 \uD30C\uC774\uD305\uD558\uC790 \uC544\uC790\uC544\uC790!\""
